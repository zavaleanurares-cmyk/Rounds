<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget. RemoteViews only, so: LinearLayout, TextView,
     ProgressBar, ImageView — no ConstraintLayout, no custom views, no Compose.
     Every id here is looked up by name from RoundsWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/rounds_widget_bg"
    android:padding="16dp">

  <TextView
      android:id="@+id/widget_headline"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/rounds_label_primary"
      android:textSize="20sp"
      android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="Nothing planned" />

  <TextView
      android:id="@+id/widget_sub"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="@color/rounds_label_secondary"
      android:textSize="13sp"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="" />

  <ProgressBar
      android:id="@+id/widget_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="6dp"
      android:layout_marginTop="10dp"
      android:max="6"
      android:progress="0"
      android:progressDrawable="@drawable/rounds_widget_progress" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="bottom"
      android:orientation="horizontal"
      android:layout_marginTop="12dp">

    <TextView
        android:id="@+id/widget_water"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:background="@drawable/rounds_widget_button"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/rounds_label_primary"
        android:textSize="13sp"
        android:maxLines="1"
        android:text="Water" />

    <TextView
        android:id="@+id/widget_again"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/rounds_widget_button"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/rounds_label_primary"
        android:textSize="13sp"
        android:maxLines="1"
        android:text="Same again" />
  </LinearLayout>
</LinearLayout>
