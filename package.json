{
  "name": "rounds",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "tokens": "node scripts/build-tokens.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "db:test": "supabase/tests/run.sh",
    "go": "ROUNDS_GO=1 expo start --tunnel",
    "go:lan": "ROUNDS_GO=1 expo start",
    "build:preview": "eas build --profile preview",
    "build:go": "eas update --branch preview",
    "check": "npm run typecheck && npm test && npm run db:test && npm run store:check",
    "store:check": "node scripts/store-check.mjs",
    "store:shots": "node scripts/store-shots.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "private": true,
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-contacts": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "^1.27.2",
    "react-native-purchases": "^10.9.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-view-shot": "^5.1.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.10",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-native-worklets": "^0.10.4",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  }
}
