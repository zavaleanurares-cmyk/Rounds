{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx expo prebuild:*)",
      "Bash(npx expo export:*)",
      "Bash(npx expo-doctor)",
      "Bash(bash supabase/tests/run.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase secrets set:*)"
    ],
    "deny": [
      "Bash(npm audit fix --force:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
