# dependencies
node_modules/

# expo
#
# ANCHORED, and that matters. `ios/` and `android/` without a leading slash match
# a directory at ANY depth, so they were also matching
# `modules/rounds-native/ios/` and `modules/rounds-native/android/` — the entire
# native module. Eight Swift files, the podspec, the Gradle build and the Kotlin
# source had never been committed, which would have put a repo on GitHub with no
# Live Activity, no widgets, no App Intents, no Control Center control and no
# Quick Settings tile. The prebuild output these are meant to exclude only ever
# appears at the root.
/ios/
/android/
.expo/
dist/
web-build/
*.orig.*
expo-env.d.ts

# native builds
*.jks
*.p8
*.p12
*.key
*.mobileprovision
play-service-account.json

# env
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# os
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/
*.swp

# Store screenshots are GENERATED — `npm run store:shots` rebuilds all eighteen
# from the current web export in about a minute. Committing 16MB of PNGs that
# change with every UI tweak buys nothing that the script does not.
store/screenshots/
